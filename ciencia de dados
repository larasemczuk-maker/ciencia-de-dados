        "petals = []\n",
        "n_petals = 12\n",
        "\n",
        "for i in range(n_petals):\n",
        "    petal, = ax.plot([], [], 'o-', color='magenta', linewidth=2, markersize=8)\n",
        "    petals.append(petal)\n",
        "\n",
        "center, = ax.plot([], [], 'o', color='yellow', markersize=20)\n",
        "\n",
        "def animate(frame):\n",
        "    # Animar as pétalas\n",
        "    for i, petal in enumerate(petals):\n",
        "        angle = i * (2*np.pi/n_petals) + frame * 0.1\n",
        "        wave = 0.2 * np.sin(frame * 0.2)\n",
        "\n",
        "        # Posição da pétala com movimento ondulatório\n",
        "        x_outer = (1 + wave) * np.cos(angle)\n",
        "        y_outer = (1 + wave) * np.sin(angle)\n",
        "        x_inner = 0.3 * np.cos(angle)\n",
        "        y_inner = 0.3 * np.sin(angle)\n",
        "\n",
        "        petal.set_data([x_inner, x_outer], [y_inner, y_inner])\n",
        "\n",
        "    # Centro pulsante\n",
        "    pulse = 1 + 0.1 * np.sin(frame * 0.3)\n",
        "    center.set_markersize(20 * pulse)\n",
        "\n",
        "    return petals + [center]\n",
        "\n",
        "# Criar animação\n",
        "ani = FuncAnimation(fig, animate, frames=100, interval=50, blit=True)\n",

        "# Gerar dados fictícios de e-commerce\n",
        "np.random.seed(42)  # Para resultados reproduzíveis\n",
        "\n",
        "# Parâmetros\n",
        "n_clientes = 1000\n",
        "data_inicio = datetime(2024, 1, 1)\n",
        "data_fim = datetime(2024, 12, 31)\n",
        "\n",
        "# Criar DataFrame\n",
        "dados = pd.DataFrame({\n",
        "    'cliente_id': range(1, n_clientes + 1),\n",
        "    'idade': np.random.randint(18, 70, n_clientes),\n",
        "    'genero': np.random.choice(['Masculino', 'Feminino'], n_clientes),\n",
        "    'cidade': np.random.choice(['São Paulo', 'Rio de Janeiro', 'Belo Horizonte', 'Porto Alegre', 'Salvador'], n_clientes),\n",
        "    'valor_compra': np.round(np.random.exponential(150, n_clientes), 2),\n",
        "    'quantidade_itens': np.random.randint(1, 15, n_clientes),\n",
        "    'categoria': np.random.choice(['Eletrônicos', 'Roupas', 'Casa', 'Livros', 'Esportes'], n_clientes),\n",
        "    'forma_pagamento': np.random.choice(['Cartão', 'Boleto', 'PIX', 'Transferência'], n_clientes),\n",
        "    'avaliacao': np.random.randint(1, 6, n_clientes),\n",
        "    'frete': np.round(np.random.uniform(5, 50, n_clientes), 2)\n",
        "})\n",
        "\n",
        "# Adicionar data da compra\n",
        "dados['data_compra'] = pd.date_range(start=data_inicio, end=data_fim, periods=n_clientes)\n",
        "\n",
        "# Calcular valor total\n",
        "dados['valor_total'] = dados['valor_compra'] + dados['frete']\n",
        "\n",
        "# Adicionar coluna de faixa etária\n",
        "def classificar_idade(idade):\n",
        "    if idade <= 25:\n",
        "        return '18-25'\n",
        "    elif idade <= 35:\n",
        "        return '26-35'\n",
        "    elif idade <= 45:\n",
        "        return '36-45'\n",
        "    elif idade <= 55:\n",
        "        return '46-55'\n",
        "    else:\n",
        "        return '56+'\n",
        "\n",
        "dados['faixa_etaria'] = dados['idade'].apply(classificar_idade)\n",
        "\n",
        "print(\"📊 Dataset criado com sucesso!\")\n",
        "print(f\"Shape: {dados.shape}\")\n",
        "dados.head()"

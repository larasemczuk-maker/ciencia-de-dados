      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "def create_flower_garden():\n",
        "    fig, ax = plt.subplots(figsize=(12, 8))\n",
        "    ax.set_aspect('equal')\n",
        "    ax.set_facecolor('#e6f3ff')\n",
        "    ax.axis('off')\n",
        "    plt.title('🌷 Jardim de Flores', fontsize=20, color='darkgreen', pad=20)\n",
        "\n",
        "    # Criar múltiplas flores em posições diferentes\n",
        "    flower_positions = [(-3, 1), (0, 2), (3, 1), (-2, -1), (2, -1)]\n",
        "    flower_colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7']\n",
        "\n",
        "    for (x, y), color in zip(flower_positions, flower_colors):\n",
        "        # Caule\n",
        "        ax.plot([x, x], [y-1.5, y-0.2], color='green', linewidth=3)\n",
        "\n",
        "        # Folhas\n",
        "        leaf_theta = np.linspace(0, np.pi, 30)\n",
        "        leaf_x = x + 0.5 * np.cos(leaf_theta)\n",
        "        leaf_y = y - 0.8 + 0.3 * np.sin(leaf_theta)\n",
        "        ax.fill(leaf_x, leaf_y, color='lightgreen', alpha=0.7)\n",
        "\n",
        "        # Flor\n",
        "        n_petals = 6\n",
        "        for i in range(n_petals):\n",
        "            angle = i * (2*np.pi/n_petals)\n",
        "            theta = np.linspace(0, 2*np.pi, 50)\n",
        "            petal_x = x + 0.8 * np.cos(theta + angle) * np.abs(np.cos(theta))\n",
        "            petal_y = y + 0.8 * np.sin(theta + angle) * np.abs(np.cos(theta))\n",
        "            ax.fill(petal_x, petal_y, color=color, alpha=0.8)\n",
        "\n",
        "        # Centro\n",
        "        center = plt.Circle((x, y), 0.2, color='yellow', zorder=5)\n",
        "        ax.add_artist(center)\n",
        "\n",
        "    # Grama\n",
        "    x_grass = np.linspace(-5, 5, 100)\n",
        "    y_grass = -2 + 0.1 * np.sin(10 * x_grass)\n",
        "    ax.fill_between(x_grass, -3, y_grass, color='lightgreen', alpha=0.6)\n",
        "\n",
        "    # Sol\n",
        "    sun = plt.Circle((4, 3), 0.5, color='yellow')\n",
        "    ax.add_artist(sun)\n",
        "\n",
        "    # Raios de sol\n",
        "    for i in range(12):\n",
        "        angle = i * (2*np.pi/12)\n",
        "        ray_length = 0.8\n",
        "        ray_x = [4 + 0.5*np.cos(angle), 4 + (0.5+ray_length)*np.cos(angle)]\n",
        "        ray_y = [3 + 0.5*np.sin(angle), 3 + (0.5+ray_length)*np.sin(angle)]\n",
        "        ax.plot(ray_x, ray_y, color='yellow', linewidth=3)\n",
        "\n",
        "    plt.xlim(-5, 5)\n",
        "    plt.ylim(-3, 4)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "create_flower_garden()"
      ],
